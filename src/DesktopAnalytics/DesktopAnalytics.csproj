<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
<PropertyGroup>
	<TargetFrameworks>net462;netstandard2.0;net8.0</TargetFrameworks>
	<PackageId>SIL.DesktopAnalytics</PackageId>
	<Authors>John Hatton, Stephen McConnel, Tom Bogle, Eberhard Beilharz, John Thomson, Andrew Polk, Jason Naylor</Authors>
	<Company>SIL International</Company>
	<PackageLicenseExpression>MIT</PackageLicenseExpression>
	<PackageProjectUrl>https://github.com/sillsdev/desktopanalytics.net</PackageProjectUrl>
	<RepositoryUrl>https://github.com/sillsdev/desktopanalytics.net</RepositoryUrl>
	<Description>Wrapper around segment.com's Analytics.net specifically for desktop apps (instead of servers).</Description>
</PropertyGroup>
<PropertyGroup>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <SignAssembly>False</SignAssembly>
    <AssemblyOriginatorKeyFile>..\..\DesktopAnalytics.snk</AssemblyOriginatorKeyFile>
</PropertyGroup>
<ItemGroup>
    <PackageReference Include="JetBrains.Annotations" Version="2023.2.0">
      <PrivateAssets>All</PrivateAssets>
    </PackageReference>
    <!-- Kept unconditional (incl. net8.0) even though TimeProvider itself is in-box there: this
         package's CreateCancellationTokenSource extension method is used by
         SIL.DesktopAnalytics.Mixpanel's MixpanelClient, which is not in-box; kept here (rather than
         only in the Mixpanel project) so it flows transitively via the ProjectReference. -->
    <PackageReference Include="Microsoft.Bcl.TimeProvider" Version="8.0.0" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="1.1.1" PrivateAssets="All" />
</ItemGroup>
<ItemGroup>
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="8.0.0" Condition="'$(TargetFramework)' != 'net462'" />
    <PackageReference Include="System.Text.Json" Version="8.0.5" Condition="'$(TargetFramework)' != 'net8.0'" />
</ItemGroup>
<ItemGroup>
  <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  <PackageReference Include="GitVersion.MsBuild" Version="5.12.0">
    <PrivateAssets>all</PrivateAssets>
    <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
  </PackageReference>
  <PackageReference Include="Segment.Analytics.CSharp" Version="2.3.0" />
</ItemGroup>
<ItemGroup Condition="'$(TargetFramework)' == 'net462'">
  <Reference Include="System.Configuration" />
</ItemGroup>
<ItemGroup>
  <Compile Remove="AnalyticsSettings.Designer.cs" Condition="'$(TargetFramework)' != 'net462'" />
  <Compile Update="AnalyticsSettings.Designer.cs">
    <DesignTime>True</DesignTime>
    <AutoGen>True</AutoGen>
    <DependentUpon>AnalyticsSettings.settings</DependentUpon>
  </Compile>
</ItemGroup>
<ItemGroup>
  <None Update="AnalyticsSettings.settings">
    <Generator>SettingsSingleFileGenerator</Generator>
    <LastGenOutput>AnalyticsSettings.Designer.cs</LastGenOutput>
  </None>
</ItemGroup>
<ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
    <_Parameter1>DesktopAnalyticsTests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
</Project>